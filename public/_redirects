# Cloudflare redirect rules.
#
# Next copies everything in public/ into the static export, so this file ends up
# at out/_redirects, which is where Workers static assets expects it. Cloudflare
# consumes it; it is never served to visitors.
#
# Syntax: [source] [destination] [status]

# The journey moved to /amonel/ with the rebrand (Phase 9A). Old links and
# search results keep working. Both spellings of each path, so neither depends
# on the asset layer's trailing-slash handling. First match wins, so
# these sit above the /de/* catch-all.
/journey        /amonel/     301
/journey/       /amonel/     301
/en/journey     /en/amonel/  301
/en/journey/    /en/amonel/  301
/fa/journey     /fa/amonel/  301
/fa/journey/    /fa/amonel/  301
/de/journey     /amonel/     301
/de/journey/    /amonel/     301

# German is the default locale and lives at the root path. /de would be a
# duplicate of /, so it is never generated - send anyone who guesses it home.
# This replaces what used to be an nginx rule.
/de     /   301
/de/*   /   301

# /favicon.ico is a real file since Phase 9A (public/favicon.ico), so it needs
# no redirect any more.

# The share images were renamed on 2026-09-24 (ROADMAP SEO-16). Anything that
# cached the old URLs (link previews, other sites) keeps getting the picture.
# The coming-soon Worker carries the same rules (soon/_redirects).
/og/og-de.png  /og/ahmadreza-taheri-de.png  301
/og/og-en.png  /og/ahmadreza-taheri-en.png  301
/og/og-fa.png  /og/ahmadreza-taheri-fa.png  301

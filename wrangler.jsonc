{
  // Cloudflare Workers with static assets, plus one Worker script for /api/*.
  //
  // The site is still a static export: `npm run build` produces nothing but
  // `out`, and the application code never imports `worker/`. The Worker
  // answers `/api/*` only: the anonymous public counters (Phase 9C,
  // DECISIONS.md 56). `run_worker_first` lists that one path pattern, so
  // every other request is served from `out` by Cloudflare's asset layer
  // without waking the Worker - headers, redirects and the 404 page behave
  // exactly as in a pure static deploy, and the site stays portable to any
  // plain web server (the counters then simply stay hidden).
  //
  // Phase 8A built a Gemini proxy here; Phase 8B removed it (DECISIONS.md,
  // entry 53). The assistant answers entirely in the visitor's browser and
  // needs no key, no secret and no Worker call of its own.
  //
  // Pages is the older product. Cloudflare still supports it but directs all
  // new investment at Workers, and a Cloudflare account created in 2026 may not
  // show a Pages tab at all. See DECISIONS.md entry 2.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ahmadreza-de",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-15",

  "assets": {
    // Next.js `output: 'export'` writes here. `_headers` and `_redirects` are
    // copied in from `public/` by the build and are read by Cloudflare rather
    // than served to visitors.
    "directory": "./out",

    // Only these paths run the Worker first. Everything else is an asset.
    "run_worker_first": ["/api/*"],

    // The Worker's own way back to the assets (used only if the list above ever widens).
    "binding": "ASSETS",

    // The export is directory-based (`/en/index.html`) because
    // `trailingSlash: true`. auto-trailing-slash resolves both `/en` and `/en/`
    // to that file.
    "html_handling": "auto-trailing-slash",

    // Serve Next's own `404.html` with a real 404 status. Not
    // "single-page-application": this site has genuinely distinct URLs per
    // locale and a soft 404 would poison the search results we are optimising
    // for.
    "not_found_handling": "404-page"
  },

  // The counters: one table, a name and an integer per row (migrations/).
  // `database_id` is a placeholder until the database is created at deploy
  // time (TODO.md, Phase 13); `wrangler dev --local` does not need a real one.
  "d1_databases": [
    {
      "binding": "COUNTERS_DB",
      "database_name": "amonel-counters",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "observability": {
    "enabled": true
  }
}
